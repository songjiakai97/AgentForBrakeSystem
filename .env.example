# LLM（OpenAI Compatible）。留空或缺失时自动降级为「仅规则 + 离线路由」模式。
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# 上下文预算（估算 token，非精确 tokenizer 计数）。详见 design.md §6.10。
# CONTEXT_MAX_TOKENS：一次 LLM 请求允许的最大上下文，超出即整轮丢弃/就地截断兜底。
# CONTEXT_COMPRESS_TOKENS：达到该值即触发压缩，把最早的若干轮折叠为一条摘要。
# 约束：CONTEXT_COMPRESS_TOKENS 必须小于 CONTEXT_MAX_TOKENS；
#      CONTEXT_COMPRESS_TOKENS 留空时取 CONTEXT_MAX_TOKENS 的 75%（不低于 1024）。
CONTEXT_MAX_TOKENS=8000
CONTEXT_COMPRESS_TOKENS=6000

# 调试 trace 内存上限
TRACE_STORE_MAX=500

# 语义检索（RAG）开关：false 时只用 kb_ref 精确取（规则命中引用）；
# true（默认）且 OPENAI_EMBED_MODEL 已配置时启用手册语义检索，embedding
# 端点不可用会自动退回关键词打分，不阻塞分析链路
ENABLE_RAG=true

# embedding（RAG 向量检索；OPENAI_EMBED_MODEL 留空 = 不启用，检索退回关键词打分）
# 本地 LM Studio：与主对话同源时只配 MODEL 即可（BASE_URL/KEY 自动回落主配置）
#   OPENAI_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
# OpenAI 官方（或任意 OpenAI Compatible 端点）：三行都配
#   OPENAI_EMBED_BASE_URL=https://api.openai.com/v1
#   OPENAI_EMBED_API_KEY=sk-...
#   OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_BASE_URL=
OPENAI_EMBED_API_KEY=
OPENAI_EMBED_MODEL=
